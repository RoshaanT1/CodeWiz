# Names only. Never put real values in this file.
# Locally: copy this file to .env.local and fill it in (.env.local is never committed).
# In the workspace preview: add each value in the Secrets panel.
# On Vercel: add each value under Project Settings > Environment Variables.

# Supabase project URL (Project Settings > API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key (Project Settings > API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role secret key (Project Settings > API > service_role).
# Server-only. Used exclusively by admin client to securely access planted_bugs answer keys.
SUPABASE_SECRET_KEY=

# GitHub personal access token for reading public repos. Server only, never sent to the browser.
GITHUB_TOKEN=

# Default AI Provider ("gemini", "groq", "openai", "anthropic", "openrouter")
AI_PROVIDER=gemini
GEMINI_API_KEY=
