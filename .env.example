# Names only. Never put real values in this file.
# Locally: copy this file to .env.local and fill it in (.env.local is never committed).
# In the workspace preview: add each value in the Secrets panel.
# On Vercel: add each value under Project Settings > Environment Variables.

# Supabase project URL (Project Settings > API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key (Project Settings > API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub personal access token for reading public repos. Server only, never sent to the browser.
GITHUB_TOKEN=

# Supabase secret (service role) key. Server only: used for the answer key and scoring writes.
SUPABASE_SECRET_KEY=

# Extra: set to "true" to show library suggestions (AI step H, checked against npm, PyPI and the Python stdlib).
FEATURE_LIBRARY_CHECK=

# Most AI calls one user can make per day across quiz, drill and suggestions (default 300).
DAILY_AI_CALL_LIMIT=

# Most rounds one user can start per day (default 10).
DAILY_ROUND_LIMIT=

# Extra: set to "true" to show the metrics panel on the repo page.
FEATURE_METRICS=
